# Grow Up environment template — placeholder values only. Never commit real secrets.
# Copy to .env for local development (see app/config.py). The .env file is git-ignored.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=growup_dev
DATABASE_USER=growup_app
DATABASE_PASSWORD=change-me
# Shared secret for POST /discovery/intake (client sends X-Intake-Key header).
# Required: intake fails closed with 503 when unset. Use a long random value.
INTAKE_API_KEY=change-me
# Brave Search Web API subscription token (sent as X-Subscription-Token).
BRAVE_SEARCH_API_KEY=
# Shared secret for POST /discovery/research-runs (client sends X-Research-Key header).
RESEARCH_API_KEY=change-me
# Phase 3C-3B-2A verified identities (no routes accept these yet; internal-only).
# Human authorizer PUBLIC keys: name:hex-pubkey,... Public keys are verification
# material, not secrets -- but private keys must NEVER appear here or anywhere
# in the application environment; they stay with the human operator offline.
AUTHORIZER_PUBLIC_KEYS=
# Executor service credentials: id:secret,... Secrets: same handling as all
# other env secrets (restricted file, never committed, never logged).
EXECUTOR_KEYS=
# Orchestrator service credentials: id:secret,... Separate namespace from
# EXECUTOR_KEYS -- an orchestrator credential never verifies as an executor.
# Every value here must differ from every EXECUTOR_KEYS value: a secret
# enrolled in both namespaces is rejected and NEITHER role can authenticate.
ORCHESTRATOR_KEYS=
# Action-type scopes (Phase 3C-3B-2B): id:type|type,...
# Grants match the stored action_type exactly (case-sensitive, no wildcards);
# missing, empty, or malformed maps deny. Example shape (placeholder only):
# EXECUTOR_SCOPES=w-1:outreach_email|contract_sign
# ORCHESTRATOR_SCOPES=sched-1:outreach_email
EXECUTOR_SCOPES=
ORCHESTRATOR_SCOPES=
# Wondrue system-wide read identity (Phase 3C-3B-3A): names one enrolled
# orchestrator id whose verified credential grants read-only visibility
# across action types. The name alone confers nothing without the
# credential; unset means nobody holds system-wide read access.
WONDRUE_READER_ID=
# Reconciler enrollment (Phase 3C-3B-3B): name:hex-pubkey,... for humans
# permitted to approve UNKNOWN-outcome reconciliation. Separate
# permission from AUTHORIZER_PUBLIC_KEYS: neither enrollment implies
# the other. Public verification material (never secrets); same
# handling as other env configuration, never committed with real keys.
RECONCILER_PUBLIC_KEYS=
# Monthly Brave request ceiling (positive integer, default 100).
BRAVE_MONTHLY_CEILING=100
# Agent observability (MVP-004C-A): all optional, safe defaults shown.
# JSONL trace directory (Ubuntu: /var/www/growup/logs, pre-created, growup-owned).
OBS_LOG_DIR=logs
# Master observability switch (default enabled). The test suite forces OBS_ENABLED=0
# so ambient instrumentation never touches real sinks; explicit test sinks stay enabled.
# OBS_ENABLED=1
# Trace level: DEBUG, INFO, WARNING, ERROR (default INFO).
OBS_LOG_LEVEL=INFO
# Diagnostic trace retention in days (default 90).
OBS_DIAGNOSTIC_RETENTION_DAYS=90
# Routine activity retention in days (default 365). Permanent events are never auto-deleted.
OBS_ACTIVITY_RETENTION_DAYS=365
# Per-event detail payload cap in bytes (default 8192; truncated with marker when exceeded).
OBS_MAX_DETAIL_BYTES=8192
# Per-event evidence reference cap (default 50).
OBS_MAX_EVIDENCE_REFS=50
# Trace file rotation: max bytes per file and retained backups (defaults 10MB x 10).
OBS_LOG_MAX_BYTES=10485760
OBS_LOG_BACKUP_COUNT=10
# Durable SQLite outbox for permanent events (Ubuntu:
# /var/www/growup/shared/observability/events-outbox.sqlite3).
OBS_OUTBOX_PATH=outbox/events-outbox.sqlite3
# Delivered-outbox-row retention in days (default 30). Pending rows are
# never purged; only rows explicitly marked delivered can match cleanup.
OBS_DELIVERED_RETENTION_DAYS=30
# Coordinated MVP workflow (Gabriel -> Raphael -> Onesimus + Wondrue).
# Master switch for the real-property evaluation entry points (default
# disabled). Synthetic demonstration needs none of the values below.
MVP_WORKFLOW_ENABLED=0
# Meta inference over the Baseten HTTP transport: META_API_URL accepts
# either the API base (https://inference.baseten.co/v1) or the full
# chat-completions endpoint (.../v1/chat/completions); the adapter
# resolves both to chat-completions. Model id and server-side
# credential below. The key never leaves the server process.
META_API_URL=https://inference.baseten.co/v1
META_API_KEY=
META_MODEL=meta-models/muse-spark-open-1026
# Explicit spending authorization for live Meta calls (default refused).
# Replay mode needs no approval and spends nothing.
META_SPEND_APPROVED=0
# Administrator completion ceiling for live Meta calls (code default
# 1024 when unset). 8192 lets all four throttle profiles operate when
# explicitly enabled; lower values clamp profile limits (reported as
# requested-vs-effective, never silent). The transport clamps here too.
META_MAX_TOKENS=8192
# Bounded provider timeout in seconds (default 60) and response-size
# cap in bytes (default 262144). Out-of-range values fall back safely.
META_TIMEOUT_SECONDS=60
META_MAX_RESPONSE_BYTES=262144
# Shared inference budget: a competition-wide TOKEN allowance (never
# auto-reset), not a monetary ceiling. 0 (default) disables live
# calls until the owner grants an allowance. Reservations are
# conservative byte-based upper bounds; reported overruns are charged
# back to the same allowance. Provisional separate-rate pricing is
# required for live execution: reference USD per 1M input/output
# tokens plus a safety multiplier (planning rate = reference x
# multiplier). Application estimates stay distinct from provider
# billing and never gate execution alone. The retired blended-rate
# variable INFERENCE_USD_PER_1K_TOKENS must stay unset: its presence
# is a loud configuration error, never a silent fallback.
INFERENCE_TOKEN_ALLOWANCE=0
INFERENCE_USD_PER_1M_INPUT=1.25
INFERENCE_USD_PER_1M_OUTPUT=4.25
INFERENCE_PRICING_MULTIPLIER=2.0
INFERENCE_PRICING_STATUS=provisional
INFERENCE_PRICING_SOURCE=https://www.baseten.co/library/muse-spark-open/
INFERENCE_PRICING_DATE=2026-10-30
# Token units protected for the demonstration (default 0) and the
# single-request size needing an ask-mode token at/after 90%
# (default 8000).
INFERENCE_DEMO_RESERVE=0
INFERENCE_LARGE_BATCH_TOKENS=8000
# Explicit per-image token bound (no default). Live media execution
# is refused until the owner configures this bound.
INFERENCE_TOKENS_PER_IMAGE=
# Prompt-size bound in characters (default 60000) and in-process
# concurrency bound (default 4).
INFERENCE_MAX_PROMPT_CHARS=60000
INFERENCE_MAX_CONCURRENT=4
# Global external-behavior mode: yes (default, safe) means prepare with
# real data but simulate downstream external execution; no additionally
# forbids Priscilla simulated events. Gabriel, Raphael, Onesimus, and
# Michael stay genuine in both modes; Uriel prepares genuine packages
# without sending in both. Any other value is rejected.
# Deployment target is independent of demo/live external-action behavior.
# DEV_SERVER => private dev box; LIVE_SERVER => public VPS. No automatic deploy.
SERVER_MODE=DEV_SERVER
DEMO_MODE=yes
# Emergency synthetic-harness override (default unset = restricted).
# After the first evidenced 144-dossier pilot, ordinary operational
# selection of the synthetic upstream harness is refused; setting this
# to 1 with explicit owner authorization permits diagnostic execution.
EMERGENCY_DIAGNOSTIC_DEMO=0
# Server-side HMAC key authenticating custody receipts (minimum 16
# characters; generate a long random value). Custody refuses to issue or
# verify receipts while this is missing or short.
CUSTODY_HMAC_KEY=
# Comma-separated handles permitted to author dossier amendments
# (e.g. CUSTODY_AMENDERS=op-1,op-2). Empty means all amendments refused.
CUSTODY_AMENDERS=
# Bounded DCAD commercial-account collection (default disabled). The
# collector fetches one approved account page only when enabled here
# AND the account is allowlisted below; anything else is refused
# before any network call. Live retrieval stays owner-executed after
# separate approval.
DCAD_COLLECTION_ENABLED=0
DCAD_ALLOWED_ACCOUNTS=
# Bounded Census geocoder county admission (default disabled). The
# collector geocodes one stored Texas address per attempt only when
# enabled here AND the call carries explicit approval with a bounded
# request allowance; anything else is refused before any network
# call. Live retrieval stays owner-executed after separate approval.
CENSUS_COLLECTION_ENABLED=0
# Wondrue cockpit credentials (client sends one on the X-Wondrue-Key
# header). The operator key grants the full mode range; the reader key
# grants read-only. The requested mode is capped by this server-side
# grant, so supplying "mode": "full" confers no authority by itself.
# Both unset fails closed (503); missing or unknown key returns 401.
WONDRUE_OPERATOR_KEY=
WONDRUE_READER_KEY=
# Shared discovery / asset-monitor Sabbath blackout (default enabled).
# Friday astronomical dusk through Saturday astronomical dusk in Asia/Jerusalem.
# Astronomical dusk: geometric solar centre 18 degrees below a level horizon.
# Calculated offline for Jerusalem 31.778 N, 35.235 E; seasonal/DST changes apply.
# Start rounds down, end up to whole minute. Calculation/tzdata failure closes.
# Retired SABBATH_START / SABBATH_END fixed-clock values are ignored.
# Set 0 only with explicit operator authorization.
SABBATH_BLACKOUT=1

# Isolated synthetic canonical-custody demonstration. No DATABASE_* fallback.
# Never reuse operational credentials or CUSTODY_HMAC_KEY.
# Owner setup script provisions these only in the dedicated demo env file.
HANDOFF_DEMO_ENABLED=0
HANDOFF_DEMO_DATABASE_HOST=127.0.0.1
HANDOFF_DEMO_DATABASE_PORT=5432
HANDOFF_DEMO_DATABASE_NAME=growup_handoff_demo
HANDOFF_DEMO_DATABASE_USER=growup_demo
HANDOFF_DEMO_DATABASE_PASSWORD=
HANDOFF_DEMO_HMAC_KEY=

# Optional signed tracking gateway. Disabled until separately configured.
# Never reuse a Wondrue, provider API or custody key. Keep real values out of Git.
TRACKING_INGRESS_ENABLED=0
TRACKING_INGRESS_SOURCES={}
# Example source mapping (replace package UUID and configure its separate key):
# {"gateway-a":{"secret_env":"TRACKING_INGRESS_KEY_GATEWAY_A","allowed_packages":["PACKAGE_UUID"],"allow_simulated":false}}
TRACKING_INGRESS_KEY_GATEWAY_A=

# Native Resend event tracking. No sender, account creation or provider calls.
RESEND_TRACKING_ENABLED=0
# Direct Uriel/Simeon/Solomon mailbox intake and internal drafts; no delivery.
RESEND_MAILBOX_ROUTING_ENABLED=0
# Owner-only demo review email exception; ordinary demo outreach stays simulated.
# Prefer transient approval/authorization supplied by the reviewed proof helper.
URIEL_DEMO_SEND_APPROVED=0
URIEL_DEMO_SEND_AUTHORIZATION=
# Separate receiving-read credential; never print or commit its actual value.
RESEND_RECEIVING_API_KEY=
# Bounded owner-mail correspondence proof only, not general outbound permission.
CORRESPONDENCE_PROOF_APPROVED=0
RESEND_WEBHOOK_SECRET=
RESEND_SENDER=uriel@securecodeusa.com
# Exact Resend-managed receiving domain or separately verified receiving subdomain.
# Do not replace existing securecodeusa.com MX records for this integration.
# REPLACE_ME_RECEIVING_DOMAIN: actual Resend receiving domain must replace this.
RESEND_RECEIVING_DOMAIN=REPLACE_ME_RECEIVING_DOMAIN.example.invalid
# Optional: restrict native inbox.email.received/sent events to this exact Inbox UUID.
RESEND_INBOX_ID=

# REPLACE_ME_CALLBACK_HOST: future public HTTPS callback; never register this placeholder.
# Informational/preflight setting, not an instruction to open a listener or deploy.
RESEND_PUBLIC_CALLBACK_URL=https://REPLACE_ME_CALLBACK_HOST.example.invalid/integrations/resend/webhook

# Inbound conversations: Simeon primary, Priscilla controlled backup; never sends.
COMMUNICATIONS_ROUTER_ENABLED=0
# Provider access is separately authorized. All disabled/zero by default.
RESEND_API_KEY=
RESEND_POLL_ENABLED=0
RESEND_POLL_ACCESS_APPROVED=0
RESEND_POLL_AUTHORIZATION_ID=
RESEND_POLL_REQUEST_ALLOWANCE=0
RESEND_POLL_APPROVAL_EXPIRES_AT=

# Internal automatic due-date monitoring. The reviewed development timer enables
# its own worker process only; application/web processes remain disabled.
ASSET_MONITOR_ENABLED=0
